# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://your-supabase-host:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=http://your-supabase-host:8000
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@your-supabase-host:5433/postgres

# Receiver (Rust): use the session pooler URL
DATABASE_URL=postgresql://postgres:password@your-supabase-host:5432/postgres

# Application URLs
NEXT_PUBLIC_WEBHOOK_URL=https://your-receiver-domain.com
NEXT_PUBLIC_APP_URL=https://your-app-domain.com
# Internal receiver URL (used by web app for health checks and test sends)
RECEIVER_INTERNAL_URL=http://localhost:3001

# Receiver <-> control plane auth; also signs the MX host's mail ingest requests
CAPTURE_SHARED_SECRET=your-shared-secret

# Polar.sh Billing (optional)
POLAR_SANDBOX=true
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
# Seat-based Teams product (Polar dashboard -> product with "Seat-based" pricing)
# POLAR_TEAMS_PRODUCT_ID=
# Extra request capacity, offered once all four are set: one-time blocks
# (unit-priced), monthly blocks (unit-priced subscription), monthly blocks added
# mid-period (one-time, at the monthly unit price), and overage (a subscription
# with only a metered price on a meter that sums the "requests" property of
# "request.overage" events).
# POLAR_REQUEST_BLOCKS_PRODUCT_ID=
# POLAR_MONTHLY_BLOCKS_PRODUCT_ID=
# POLAR_MONTHLY_BLOCKS_ADD_PRODUCT_ID=
# POLAR_OVERAGE_PRODUCT_ID=
# Business (the plan, monthly and annual) and the Team Business add-on on a
# team's seat subscription.
# POLAR_BUSINESS_PRODUCT_ID=
# POLAR_BUSINESS_ANNUAL_PRODUCT_ID=
# POLAR_TEAM_BUSINESS_PRODUCT_ID=
# Parsed pages beyond the plan's, Business only, the same four ways as
# requests (the overage meter sums "pages" of "page.overage" events).
# POLAR_PAGE_BLOCKS_PRODUCT_ID=
# POLAR_MONTHLY_PAGE_BLOCKS_PRODUCT_ID=
# POLAR_MONTHLY_PAGE_BLOCKS_ADD_PRODUCT_ID=
# POLAR_PAGE_OVERAGE_PRODUCT_ID=
# Extra custom inbound domains: monthly units and units added mid-period.
# POLAR_DOMAINS_PRODUCT_ID=
# POLAR_DOMAINS_ADD_PRODUCT_ID=

# Blog admin API (optional)
BLOG_API_SECRET=

# Redis (optional: enables distributed rate limiting; falls back to in-memory)
# REDIS_URL=redis://localhost:6379

# Errors and log lines (optional): a StatOSS app's DSN. The web app, the
# receiver and the MX host each read STATOSS_DSN and send nothing without it.
# STATOSS_ENVIRONMENT defaults to production (development under next dev and
# in Rust debug builds).
# STATOSS_DSN=https://<key>@ingest.statoss.com/<app number>
# STATOSS_ENVIRONMENT=development
# Browser errors: a separate StatOSS app whose key only accepts your site's
# origins. Inlined at build time.
# NEXT_PUBLIC_STATOSS_DSN=https://<key>@ingest.statoss.com/<app number>

# Notification proxy (optional): routes outbound deliveries (forwarding, which
# includes notifications) through a Cloudflare Worker. Read by the web app.
# NOTIFY_PROXY_URL=https://notify-proxy.your-domain.workers.dev
# NOTIFY_SECRET=

# Email forwarding (web). The worker is on by default; without a proxy it
# connects directly and refuses private addresses. To try forwarding against a
# local server in development (ignored in production):
# FORWARDING_ALLOW_PRIVATE_TARGETS=true
# EMAIL_FORWARDING_WORKER=true

# Receiver tuning (optional; all have sensible defaults)
# PORT=3001
# RECEIVER_DEBUG=
# RECEIVER_LOG_DIR=logs
# PG_POOL_MIN=5
# PG_POOL_MAX=20
# CAPTURE_MAX_INFLIGHT_PER_ACCOUNT=4
# RECEIVER_MAX_BODY_SIZE=1048576

# Email capture (optional). The receiver's private mail listener for the MX
# host; unset keeps it off. Never expose it publicly or route it through Caddy.
# Integration tests expect 127.0.0.1:3002 (override with MAIL_INGEST_URL).
# MAIL_INGEST_ADDR=127.0.0.1:3002
# MAIL_INGEST_PAUSED=          # 1/true: answer every recipient with "try later"
# MAIL_DOMAINS=mailhooks.cc

# Object storage for captured email (optional; receiver and web app). The
# receiver keeps each email's raw message and attachments under
# m/{request_id}/ and answers "try later" when storing fails; the web app
# serves downloads and deletes objects with their requests. All four, or none.
# Give the bucket a lifecycle rule expiring m/ after 100 days as a backstop.
# OBJECT_STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=

# SMTP listener for email capture (apps/mx-rs; its own host in production).
# Signs with CAPTURE_SHARED_SECRET above. MAIL_INGEST_URL is required: the
# receiver's mail listener (MAIL_INGEST_ADDR) as a URL.
# MAIL_INGEST_URL=http://127.0.0.1:3002
# MX_LISTEN=[::]:25            # comma-separated; e.g. 127.0.0.1:2525 locally
# MX_HOSTNAME=mx.mailhooks.cc
# MX_TLS_CERT=                 # PEM files; STARTTLS is off without them
# MX_TLS_KEY=
# MX_STATE_DIR=/var/lib/webhooks-mx
# MX_HEALTH_ADDR=127.0.0.1:8025
# MX_MAX_SESSIONS=500
# MX_DATA_SLOTS=16
# MX_TRUSTED_RDNS=             # comma-separated provider domains; defaults in src/config.rs
# MX_RSPAMD_URL=http://127.0.0.1:11333   # spam verdicts, recorded and never a reason to refuse
# File drop egress (SOCKS5) for the web app's SFTP, FTP and S3 drops; private
# network only. The web app points FILE_DROP_PROXY_URL at it.
# MX_EGRESS_LISTEN=10.0.0.3:1080
# MX_EGRESS_SECRET=            # 24+ characters
# MX_EGRESS_DENY=              # comma-separated addresses to refuse besides private ones
# MX_EGRESS_ALLOW_PRIVATE=false  # debug builds only, for local test servers

# Custom inbound domains: the MX host their records must point at, public
# resolvers for the checks (comma-separated IP addresses, optional ports), and
# how often the receiver reads the verified list again.
# MAIL_MX_HOST=mx.mailhooks.cc
# DOMAIN_DNS_SERVERS=1.1.1.1,1.0.0.1
# INBOUND_DOMAINS_REFRESH_SECS=60

# File drops from the web app: the MX host's egress, as
# socks5://user:secret@<private address>:<port>. Required in production for
# drops to be offered; without it, development connects directly.
# FILE_DROP_PROXY_URL=

# Attachment parser binary (apps/parser-rs); the image ships /app/bin/webhooks-parser.
# PARSER_BIN=

# AI setup and repair (lib/ai). Offered only with a key; AI_API_BASE_URL points
# tests at a fake model and is ignored in production builds.
# ANTHROPIC_API_KEY=
# AI_API_BASE_URL=

# mailhooks.cc, the mail-first front door of the same app (a build argument:
# changing it means a new build). Unset serves one site.
# NEXT_PUBLIC_MAILHOOKS_URL=https://mailhooks.cc

# Google Sheets destinations (optional). An OAuth web client with the
# redirect URI {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback and the
# drive.file scope; the Drive picker also needs an API key (Picker API) and
# the Cloud project number.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_PICKER_API_KEY=
# GOOGLE_CLOUD_PROJECT_NUMBER=

# Alerts (lib/alerts): on by default; off for a process that should not check them.
# ALERTS_WORKER=true

# Web app tuning (optional; all have sensible defaults)
# ENDPOINT_CREATE_RATE_LIMIT=30
# ENDPOINT_CREATE_RATE_WINDOW_MS=600000
# MAX_EPHEMERAL_ENDPOINTS=500
# AGENT_SANDBOX_MAX_ENDPOINTS=200
# EPHEMERAL_TTL_HOURS=12

# Agent auth (auth.md) - optional
# RESEND_API_KEY=
# SMTP transport for agent OTP email (production only; SMTP -> Resend -> dev fallback)
# STARTTLS: SMTP_PORT=587 + SMTP_SECURE=false; implicit TLS: SMTP_PORT=465 + SMTP_SECURE=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Shared from-address for all outbound email (falls back to AGENT_EMAIL_FROM)
# EMAIL_FROM=webhooks.cc <noreply@webhooks.cc>
# AGENT_EMAIL_FROM=webhooks.cc <noreply@webhooks.cc>
# Email free users when their quota runs out (production host only; sends real mail)
# QUOTA_EMAILS_ENABLED=false
# AGENT_REGISTER_RATE_LIMIT=5
# AGENT_REGISTER_RATE_WINDOW_MS=3600000
# AGENT_IDJAG_RATE_LIMIT=60
# Trusted ID-JAG providers for the identity_assertion flow, as a JSON array.
# Each entry pins an issuer (iss, an https URL equal to the JWT "iss") and how
# to resolve its JWKS: jwks_uri (defaults to ${iss}/.well-known/jwks.json) and
# the permitted signing algs (default ES256, RS256), plus the display_name the
# claim page shows when one of its identities asks to link an existing account.
# Empty array = no trusted providers (identity_assertion is not advertised and
# every assertion answers issuer_not_enabled). Keep it empty in production
# until a real ID-JAG issuer exists.
# Example (single provider):
# AGENT_IDJAG_PROVIDERS=[{"iss":"https://idp.example.com","jwks_uri":"https://idp.example.com/.well-known/jwks.json","algs":["ES256","RS256"],"display_name":"Example IdP"}]
# AGENT_IDJAG_PROVIDERS=[]
# An ID-JAG whose auth_time is older than this answers login_required (seconds).
# AGENT_IDJAG_MAX_AUTH_AGE_SECONDS=3600
# AGENT_MAX_PENDING_OTP_PER_EMAIL=3
# Agent registration (auth.md v0.6). Anonymous registration and the sandbox
# need both secrets; without them /api/agent/identity answers 503.
# Assertion signing key, P-256 PKCS#8 PEM on one line with \n for newlines:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk 'NF {printf "%s\\n", $0}'
# AGENT_ASSERTION_SIGNING_KEY=
# Optional key id (defaults to the key's RFC 7638 thumbprint)
# AGENT_ASSERTION_SIGNING_KID=
# After a key rotation, the old key's public JWK (JSON, with its kid) for 90 days
# AGENT_ASSERTION_PREVIOUS_PUBLIC_JWK=
# Proof-of-work HMAC secret: openssl rand -base64 32 (the previous one during a rotation)
# AGENT_POW_SECRET=
# AGENT_POW_SECRET_PREVIOUS=
# Work per registration is AGENT_POW_COUNT x 2^AGENT_POW_DIFFICULTY hashes
# AGENT_POW_DIFFICULTY=18
# AGENT_POW_COUNT=32
# AGENT_ANONYMOUS_ENABLED=true
# Anonymous registrations per hour: all clients, and per IPv4 /24 or IPv6 /48
# AGENT_ANONYMOUS_GLOBAL_RATE=100
# AGENT_REGISTER_WIDE_RATE_LIMIT=20
# Live unclaimed anonymous registrations at once
# AGENT_MAX_LIVE_ANONYMOUS=500
# Unclaimed service_auth registrations naming one email at a time
# AGENT_MAX_PENDING_PER_LOGIN_HINT=3
