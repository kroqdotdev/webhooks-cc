      "tar": ">=7.5.16 <8",
      "@babel/core": ">=7.29.6 <8",
      "postcss": ">=8.5.10",
      "qs": ">=6.15.2"
    }
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@polar-sh/sdk": "^0.48.1"
  }
