{
  "name": "webhooks-cc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "build": "turbo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "test:full": "pnpm typecheck && pnpm build && make test && pnpm --filter web test:integration && PLAYWRIGHT_USE_PROD_SERVER=1 pnpm --filter web test:e2e",
    "typecheck": "turbo typecheck",
    "cli": "cd apps/cli-rs && cargo run --",
    "start": "mprocs --config mprocs.yaml"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.10",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jose": "^6.2.5",
    "nanoid": "^5.1.15",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@appsignal/nodejs"
    ],
    "overrides": {
      "ajv@^6.12.4": "6.14.0",
      "minimatch@^3.1.2": "3.1.4",
      "hono": ">=4.12.25 <5",
      "flatted": ">=3.4.2",
      "path-to-regexp": ">=8.4.0",
      "brace-expansion@^1.1.7": "1.1.13",
      "brace-expansion@^2.0.1": "2.0.3",
      "brace-expansion@^5.0.0": "5.0.5",
      "dompurify": ">=3.4.11 <4",
      "protobufjs": ">=7.6.3 <8",
      "@protobufjs/utf8": ">=1.1.1",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/core": ">=2.8.0 <3",
      "@grpc/grpc-js": ">=1.14.4 <2",
      "vite": ">=7.3.5 <8",
      "esbuild": ">=0.28.1 <0.29",
