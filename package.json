{
  "name": "webhooks-cc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "build": "turbo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "test:full": "pnpm typecheck && pnpm build && make test && pnpm --filter web test:integration && PLAYWRIGHT_USE_PROD_SERVER=1 pnpm --filter web test:e2e",
    "typecheck": "turbo typecheck",
    "cli": "cd apps/cli-rs && cargo run --",
    "start": "mprocs --config mprocs.yaml"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.6",
    "@types/node": "^25.8.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jose": "^6.2.3",
    "nanoid": "^5.1.11",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "tsx": "^4.22.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@appsignal/nodejs"
    ],
    "overrides": {
      "ajv@^6.12.4": "6.14.0",
      "minimatch@^3.1.2": "3.1.4",
      "hono": ">=4.12.18",
      "flatted": ">=3.4.2",
      "path-to-regexp": ">=8.4.0",
      "brace-expansion@^1.1.7": "1.1.13",
      "brace-expansion@^2.0.1": "2.0.3",
      "brace-expansion@^5.0.0": "5.0.5",
      "dompurify": ">=3.4.0",
      "protobufjs": ">=7.5.6 <8",
      "@protobufjs/utf8": ">=1.1.1",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "postcss": ">=8.5.10"
    }
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@polar-sh/sdk": "^0.47.1"
  }
}
