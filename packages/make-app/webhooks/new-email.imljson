{
  "name": "newEmail",
  "label": "New email",
  "type": "web",
  "connection": "apiKey",
  "parameters": [
    {
      "name": "endpoint",
      "type": "select",
      "label": "Endpoint",
      "options": "rpc://listEndpoints",
      "required": true
    }
  ],
  "attach": {
    "url": "/endpoints/{{encodeURL(parameters.endpoint)}}/destinations",
    "method": "POST",
    "body": {
      "url": "{{webhook.url}}",
      "name": "Make",
      "format": "json",
      "email": true,
      "http": false
    },
    "response": {
      "data": {
        "externalHookId": "{{body.id}}",
        "endpoint": "{{parameters.endpoint}}"
      }
    }
  },
  "detach": {
    "url": "/endpoints/{{encodeURL(webhook.endpoint)}}/destinations/{{encodeURL(webhook.externalHookId)}}",
    "method": "DELETE",
    "response": {
      "valid": "{{statusCode < 300 || statusCode == 404}}"
    }
  },
  "communication": {
    "output": "{{body.data}}"
  }
}
