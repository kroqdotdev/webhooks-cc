{
  "name": "watchEmails",
  "label": "Watch emails",
  "description": "Triggers when an endpoint receives an email, with the fields and line items its layouts read.",
  "type": "instant_trigger",
  "webhook": "newEmail",
  "connection": "apiKey",
  "interface": [
    { "name": "id", "type": "text", "label": "Request ID" },
    { "name": "receivedAt", "type": "date", "label": "Received at" },
    { "name": "address", "type": "text", "label": "Address" },
    { "name": "tag", "type": "text", "label": "Tag" },
    { "name": "subject", "type": "text", "label": "Subject" },
    {
      "name": "from",
      "type": "collection",
      "label": "From",
      "spec": [
        { "name": "name", "type": "text", "label": "Name" },
        { "name": "address", "type": "text", "label": "Address" }
      ]
    },
    { "name": "text", "type": "text", "label": "Text" },
    { "name": "html", "type": "text", "label": "HTML" },
    { "name": "replyText", "type": "text", "label": "Reply text" },
    { "name": "fields", "type": "any", "label": "Fields" },
    { "name": "parsed", "type": "any", "label": "Parsed (layout, fields, line items, attachments)" },
    { "name": "codes", "type": "array", "label": "Codes", "spec": { "type": "text" } },
    {
      "name": "attachments",
      "type": "array",
      "label": "Attachments",
      "spec": {
        "type": "collection",
        "spec": [
          { "name": "filename", "type": "text", "label": "File name" },
          { "name": "contentType", "type": "text", "label": "Content type" },
          { "name": "size", "type": "number", "label": "Size" },
          { "name": "url", "type": "url", "label": "Download link" }
        ]
      }
    }
  ],
  "samples": {
    "id": "3f2a9c1e-0000-4000-8000-000000000000",
    "receivedAt": "2026-10-29T17:33:26.000Z",
    "address": "orders-acme@mailhooks.cc",
    "subject": "Order #1001 confirmed",
    "from": { "name": "Acme Store", "address": "orders@acme.example" },
    "text": "Thanks for your order.\nTotal: $12.50",
    "fields": { "order": "1001", "total": "12.50" }
  }
}
