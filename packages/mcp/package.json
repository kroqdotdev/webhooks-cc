{
  "name": "@webhooks-cc/mcp",
  "version": "1.14.0",
  "mcpName": "io.github.kroqdotdev/webhooks-cc",
  "description": "MCP server for webhooks.cc — AI agent integration for webhook testing",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "webhooks-cc-mcp": "dist/bin/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webhook",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "webhooks-cc"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kroqdotdev/webhooks-cc",
    "directory": "packages/mcp"
  },
  "homepage": "https://webhooks.cc",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@webhooks-cc/sdk": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
